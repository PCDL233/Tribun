{
  "name": "@ai-review/cli",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "ai-review": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-review/agents": "workspace:*",
    "@ai-review/core": "workspace:*",
    "@ai-review/diff": "workspace:*",
    "@ai-review/llm": "workspace:*",
    "@ai-review/rag": "workspace:*",
    "@ai-review/report": "workspace:*",
    "@ai-review/server": "workspace:*",
    "@ai-review/shared": "workspace:*",
    "@ai-review/tools": "workspace:*",
    "@ai-sdk/openai": "catalog:",
    "@clack/prompts": "catalog:",
    "ai": "catalog:",
    "commander": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@ai-review/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
